# Neon connection string (get it from the Neon dashboard → Connection Details)
# Use the "pooled" connection string for serverless/Railway deploys.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudinary (get these from the Cloudinary dashboard home page, after
# creating a free account at cloudinary.com) — used to host uploaded photos
# instead of storing them in Postgres.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
