generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Single-row table holding Eleny's daily priority ranking state.
// (One row is enough for this app; swap for a real per-user table later if needed.)
model AppState {
  id             Int      @id @default(1)
  priorityOrder  Json     @default("[]") @map("priority_order")
  blockedIds     Json     @default("[]") @map("blocked_ids")
  lastSubmitAt   DateTime? @map("last_submit_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("app_state")
}

// One row per uploaded photo, keyed by where it's shown
// ("dest:<id>" for a destination's hero photo, "dest:<id>:highlight:<name>"
// for a highlight thumbnail). Storing the image itself (as a compressed
// data URL) instead of a filename, since Railway's filesystem isn't
// persistent across deploys.
model Photo {
  key       String   @id
  dataUrl   String   @map("data_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("photos")
}
