generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Single-row table holding Eleny's daily priority ranking state.
// (One row is enough for this app; swap for a real per-user table later if needed.)
model AppState {
  id             Int      @id @default(1)
  priorityOrder  Json     @default("[]") @map("priority_order")
  blockedIds     Json     @default("[]") @map("blocked_ids")
  hiddenIds      Json     @default("[]") @map("hidden_ids")
  profileInfo    Json     @default("{}") @map("profile_info")
  adminRanking   Json     @default("[]") @map("admin_ranking")
  lastSubmitAt   DateTime? @map("last_submit_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("app_state")
}

// One row per uploaded highlight photo, keyed "dest:<id>:highlight:<name>".
// Storing the image itself (as a compressed data URL) instead of a
// filename, since Railway's filesystem isn't persistent across deploys.
model Photo {
  key       String   @id
  dataUrl   String   @map("data_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("photos")
}

// One row per destination that has had its highlights list customized
// (added/removed/re-tagged by city). `highlights` is the full replacement
// list for that destination: [{ name, city }, ...]. Photos for each
// highlight are still tracked separately in Photo, matched by name.
model DestinationHighlights {
  destId     String   @id @map("dest_id")
  highlights Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("destination_highlights")
}

// One row per region ("mexico" | "usa") holding the custom destinations
// added from the map screen ("+ Add city"). `destinations` is the full
// replacement list of custom-added destination objects for that region.
model CustomDestinations {
  region       String   @id
  destinations Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("custom_destinations")
}

// One row per destination that has had its lodging list customized.
// `lodging` is the full replacement list for that destination: [{ name }, ...].
model DestinationLodging {
  destId    String   @id @map("dest_id")
  lodging   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("destination_lodging")
}
