generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// One row per trip a group is planning. `code` is the short, shareable
// join code; `organizerPasscode` gates the one traveler with admin powers
// (costs, hiding destinations, etc) — same lightweight, client-checked
// trust model this app has always used for "Luis's" passcode, just now
// scoped per trip instead of hardcoded.
model Trip {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  organizerPasscode String   @map("organizer_passcode")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("trips")
}

// One row per person in a trip. `info` is a free-form bag (avatar config,
// home base, free days, emergency-contact fields) — mirrors what used to
// live in app_state.profile_info[who], just per traveler now.
model Traveler {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  name        String
  isOrganizer Boolean  @default(false) @map("is_organizer")
  info        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("travelers")
}

// One row per trip holding shared, non-per-traveler state.
model TripState {
  tripId     String   @id @map("trip_id")
  blockedIds Json     @default("[]") @map("blocked_ids")
  hiddenIds  Json     @default("[]") @map("hidden_ids")
  // travelerId -> destId[] the organizer has hidden from that traveler
  // specifically (generalizes the old single "hidden from Eleny" list).
  hiddenFrom Json     @default("{}") @map("hidden_from")
  tripStart  String?  @map("trip_start")
  tripEnd    String?  @map("trip_end")
  swipeRound Int      @default(1) @map("swipe_round")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("trip_state")
}

// One row per uploaded photo, keyed "dest:<id>:highlight:<name>" (or
// ":cover" / ":lodging:<name>"), scoped per trip.
model Photo {
  tripId    String   @map("trip_id")
  key       String
  dataUrl   String   @map("data_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tripId, key])
  @@map("photos")
}

// One row per destination that's had its highlights list customized.
model DestinationHighlights {
  tripId     String   @map("trip_id")
  destId     String   @map("dest_id")
  highlights Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([tripId, destId])
  @@map("destination_highlights")
}

// One row per region ("mexico" | "usa") per trip, holding the custom
// destinations added from the map screen ("+ Add city").
model CustomDestinations {
  tripId       String   @map("trip_id")
  region       String
  destinations Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@id([tripId, region])
  @@map("custom_destinations")
}

// One row per destination that's had its lodging list customized.
model DestinationLodging {
  tripId    String   @map("trip_id")
  destId    String   @map("dest_id")
  lodging   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tripId, destId])
  @@map("destination_lodging")
}

// One row per destination with the organizer-only cost breakdown.
model DestinationCosts {
  tripId    String   @map("trip_id")
  destId    String   @map("dest_id")
  costs     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tripId, destId])
  @@map("destination_costs")
}

// One row per (traveler, destination) swipe: "like" or "nope".
model Swipe {
  tripId     String   @map("trip_id")
  travelerId String   @map("traveler_id")
  destId     String   @map("dest_id")
  choice     String
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([travelerId, destId])
  @@index([tripId])
  @@map("swipes")
}

// One row per (traveler, destination, highlight) reaction.
model Reaction {
  tripId     String   @map("trip_id")
  travelerId String   @map("traveler_id")
  destId     String   @map("dest_id")
  name       String
  reaction   String
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([travelerId, destId, name])
  @@index([tripId])
  @@map("reactions")
}

// Day-by-day plan for a destination, scoped per trip.
model Itinerary {
  tripId    String   @map("trip_id")
  destId    String   @map("dest_id")
  days      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tripId, destId])
  @@map("itineraries")
}

// Web Push subscriptions, one per device, tagged with the traveler using it.
model PushSubscription {
  endpoint   String   @id
  tripId     String   @map("trip_id")
  travelerId String   @map("traveler_id")
  keys       Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tripId])
  @@map("push_subscriptions")
}

// Single row holding the VAPID key pair, generated on first use so no env
// setup is needed to turn notifications on. Shared across all trips.
model PushConfig {
  id         Int    @id @default(1)
  publicKey  String @map("public_key")
  privateKey String @map("private_key")

  @@map("push_config")
}

// Shared "what's new" feed, scoped per trip. travelerId is null for a
// shared/system event (a match, the final winner) that isn't one person's.
model Activity {
  tripId     String   @map("trip_id")
  id         Int      @id @default(autoincrement())
  travelerId String?  @map("traveler_id")
  emoji      String
  text       String
  destId     String?  @map("dest_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tripId, createdAt])
  @@map("activity")
}
